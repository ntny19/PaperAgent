# PaperAgent local settings.
# Copy this file to ".env" (same folder) and edit the values. ".env" is git-ignored: never commit it.
# Do NOT put API keys here - PaperAgent uses your logged-in CLIs (agy / claude / codex) and needs none.

# --- required -------------------------------------------------------------
# Folder with the PDFs you have read (subfolders are included; the folder is only read, never modified).
PAPERAGENT_PAPER_ROOT=C:/Users/you/Papers

# --- code repos you reproduce papers with (optional, one line each, numbered 1, 2, 3, ...) ---------
# Format:  Name shown in the UI | absolute path to the repo | part of the paper's PDF name (so the agent finds the paper)
PAPERAGENT_WORKSPACE_1=MyPaper|C:/Users/you/GitHub/mypaper-repo|MyPaper
#PAPERAGENT_WORKSPACE_2=Another|C:/Users/you/GitHub/another-repo|Another paper title

# --- optional overrides (defaults shown) -----------------------------------
#PAPERAGENT_DATA_DIR=./data                    # where the search index is stored
#PAPERAGENT_PORT=8765
#PAPERAGENT_OLLAMA_URL=http://localhost:11434  # Ollama is used for search embeddings (and the offline model)
#PAPERAGENT_EMBED_MODEL=nomic-embed-text
